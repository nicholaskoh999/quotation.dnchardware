# ── Server-only secrets — NEVER commit ───────────────────────────────────────
# These live on the server only and are created from their .sample.php
# templates. Nothing here may enter Git, a patch, or a release ZIP.
ai_config.php
db.php

# ── Production runtime output ────────────────────────────────────────────────
error_log
*.log
# …except the audit package's own regression logs. The reports name each of
# these file by file, and a report must never claim a file the package does not
# contain — so they are tracked, and they ship inside the archive.
!FULL-AUDIT/regression-evidence/*.log
# …and a stage's own run logs, for the same reason: the stage report and
# its package manifest both name these figures, so the runs that produced
# them travel with the commit that claims them.
!FULL-AUDIT/stage-*/logs/*.log

# ── Regenerable test output ─────────────────────────────────────────────────
# Where tests/screenshots.js, tests/layout-shots.js and tests/extraction-shots.js
# write while they run. The copies that are evidence live in
# quotation-dnc-final/ and ARE committed; this is the scratch they are made in,
# and it is rebuilt from the suite whenever it is wanted.
audit-out/

# ── Release / backup archives ────────────────────────────────────────────────
# Git history is the source of truth for previous states; snapshot ZIPs of the
# whole app must not be committed back into it.
*.zip

# ── OS / editor noise ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*~

# Generated when the release archive is built: it names the commit it was
# built FROM, which is a thing a committed file cannot do about itself.
ZIP-MANIFEST.txt
