# QUOTATION NEXT — environment template. Copy to .env on each host; .env is
# never committed. Values below are safe defaults, never secrets.
APP_NAME="DNC Quotation"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

# Release identity — normally stamped into RELEASE.json by the build.
# APP_RELEASE=
# APP_GIT_SHA=
# APP_BUILT_AT=

# Production guard (handoff §2). Leave false. Only an instruction containing
# "PRODUCTION APPROVED BY OWNER" may lead to this being set to true.
QUOTATION_PRODUCTION_APPROVED=false

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# Default connection: unused by Wave 1 except tests. Keep it off the legacy DB.
DB_CONNECTION=sqlite

# Legacy QUOTATION.DNC schema — READ-ONLY in Wave 1. Preview: a COPIED / TEST
# database, never production.
LEGACY_DB_HOST=127.0.0.1
LEGACY_DB_PORT=3306
LEGACY_DB_DATABASE=
LEGACY_DB_USERNAME=
LEGACY_DB_PASSWORD=
HEALTH_CHECK_DATABASE=true

# Nothing is stored in the database by the framework itself.
SESSION_DRIVER=file
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
# Host-only cookie: keep SESSION_DOMAIN null (never .dnchardware.com).
SESSION_DOMAIN=null
# Own name — never the legacy DCQUOSESS / __Host-DCQUOSESS.
SESSION_COOKIE=dcquo_next_session
# Local plain HTTP: false. HTTPS preview: true (or delete the line: unset =
# Secure automatically on HTTPS requests).
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# Named-user sign-in (app_users on the legacy connection). See app/Auth/NOTES.md.
# QUO_AUTH_ABSOLUTE_LIFETIME=604800
# QUO_AUTH_FAILURE_DELAY_MS=400

# "Back to DNC Workspace" link, and the only origin the handoff may redirect to.
DNC_PORTAL_URL=https://portal.dnchardware.com

# DNC Workspace -> Quotation handoff (contract v2). SHIPS OFF: 404 while false.
DNC_HANDOFF_ENABLED=false
# base64: + 32 random bytes, same value as the Portal's DNC_HANDOFF_SECRET_QUOTATION.
DNC_HANDOFF_SECRET=
DNC_HANDOFF_SECRET_PREVIOUS=
# DNC_HANDOFF_CACHE_STORE=file
# Canonical DNC users (Internal PO `users`) — a SELECT-only account. Unset =
# the handoff refuses (fail closed).
DNC_USERS_DB_HOST=
DNC_USERS_DB_PORT=3306
DNC_USERS_DB_DATABASE=
DNC_USERS_DB_USERNAME=
DNC_USERS_DB_PASSWORD=
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log

# LiteSpeed on the shared host is the web server itself; set only if a proxy
# (e.g. a CDN) sits in front.
TRUSTED_PROXIES=127.0.0.1

VITE_APP_NAME="${APP_NAME}"
